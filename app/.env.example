# Config Firebase Web KHÔNG phải secret — nó nằm trong bundle client.
# Bảo mật do Security Rules + App Check đảm nhiệm.
# Copy file này thành `.env.local` rồi điền giá trị. Để trống → app chạy in-memory.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check — site key reCAPTCHA v3 (bật khi đã có domain thật)
VITE_RECAPTCHA_SITE_KEY=

# true → nối Emulator Suite; false → project thật
VITE_USE_EMULATOR=false

# Credentials cho integration test (`npm run test:firebase`) — chỉ dùng khi có project thật
VITE_TEST_EMAIL=
VITE_TEST_PASSWORD=
