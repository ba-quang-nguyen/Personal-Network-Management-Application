rules_version = '2';

// GIỚI HẠN ĐÃ BIẾT: Storage rules KHÔNG đọc được Firestore, nên không kiểm tra
// được thành viên dự án. Với app 1 người dùng, chặn tới mức "đã đăng nhập"
// + giới hạn dung lượng là đủ.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{fileId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 20 * 1024 * 1024;
    }
  }
}
